<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PremiumOTP - Virtual SMS</title>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-body: #0a0d12;
            --bg-sidebar: #121824;
            --bg-card: #182030;
            --bg-input: #0f1522;
            --primary: #00d26a;
            --primary-hover: #00b85c;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border-color: #26334d;
            --danger: #ef4444;
            --warning: #f59e0b;
            --gold: #ffd700;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
        }

        /* Sidebar Navigation */
        aside {
            width: 260px;
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            z-index: 100;
        }

        .brand-logo {
            padding: 1.2rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border-color);
        }

        .brand-badge {
            background: rgba(0, 210, 106, 0.15);
            color: var(--primary);
            font-size: 0.65rem;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 700;
        }

        .nav-menu {
            list-style: none;
            padding: 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-item a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            border-radius: 10px;
            transition: 0.2s;
            font-size: 0.95rem;
            cursor: pointer;
        }

        .nav-item.active a, .nav-item a:hover {
            background: rgba(0, 210, 106, 0.1);
            color: var(--primary);
        }

        /* Main Content Layout */
        .main-wrapper {
            margin-left: 260px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        /* Header Bar */
        header {
            background-color: var(--bg-sidebar);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .header-title {
            font-size: 1.2rem;
            font-weight: 700;
        }

        .user-widget {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .balance-chip {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            border-radius: 30px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-deposit {
            background: var(--primary);
            color: #000;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 800;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-deposit:hover {
            background: var(--primary-hover);
        }

        /* Dashboard Content Area */
        .dashboard-body {
            padding: 2rem;
            display: grid;
            grid-template-columns: 380px 1fr;
            gap: 25px;
        }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

        .card-header {
            font-size: 1.05rem;
            font-weight: 700;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
            font-weight: 600;
        }

        .form-control {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 12px 14px;
            border-radius: 10px;
            font-size: 0.95rem;
            outline: none;
            margin-bottom: 1.2rem;
            transition: 0.2s;
        }

        .form-control:focus {
            border-color: var(--primary);
        }

        .btn-order {
            width: 100%;
            background: var(--primary);
            color: #000;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-weight: 800;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-order:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
        }

        .btn-order:disabled {
            background: var(--border-color);
            color: var(--text-muted);
            cursor: not-allowed;
            transform: none;
        }

        /* Live Terminal Box */
        .terminal-box {
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            margin-bottom: 20px;
        }

        .phone-display {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: 1px;
            margin: 10px 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .btn-copy {
            background: rgba(255,255,255,0.1);
            border: none;
            color: #fff;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-copy:hover {
            background: var(--primary);
            color: #000;
        }

        .otp-display-terminal {
            background: #000000;
            border: 2px dashed var(--primary);
            border-radius: 14px;
            padding: 2rem;
            text-align: center;
        }

        .otp-code {
            font-size: 3.5rem;
            font-weight: 800;
            letter-spacing: 10px;
            color: #fff;
            margin: 10px 0;
            font-family: monospace;
        }

        .timer-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(245, 158, 11, 0.15);
            color: var(--warning);
            border: 1px solid var(--warning);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 700;
        }

        .btn-cancel {
            background: rgba(239, 68, 68, 0.15);
            color: var(--danger);
            border: 1px solid var(--danger);
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 15px;
            transition: 0.2s;
        }

        .btn-cancel:hover {
            background: var(--danger);
            color: #fff;
        }

        .btn-cancel:disabled {
            background: rgba(134, 150, 160, 0.1);
            color: var(--text-muted);
            border-color: var(--border-color);
            cursor: not-allowed;
        }

        /* Tables */
        .table-responsive {
            overflow-x: auto;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
        }

        .custom-table th, .custom-table td {
            padding: 12px 14px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.88rem;
        }

        .custom-table th {
            color: var(--text-muted);
            font-weight: 600;
        }

        .badge-success {
            background: rgba(0, 210, 106, 0.15);
            color: var(--primary);
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 0.75rem;
        }

        .badge-processing {
            background: rgba(245, 158, 11, 0.15);
            color: var(--warning);
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 0.75rem;
        }

        /* Deposit Modal & Styles */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(5px);
        }

        .payment-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            width: 100%;
            max-width: 440px;
            padding: 1.8rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            position: relative;
        }

        .amount-options {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 1.2rem;
        }

        .amount-btn {
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 12px;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
            position: relative;
            text-align: center;
        }

        .amount-btn:hover, .amount-btn.active {
            border-color: var(--primary);
            background: rgba(0, 210, 106, 0.15);
            color: var(--primary);
        }

        .bonus-tag {
            position: absolute;
            top: -8px;
            right: -5px;
            background: linear-gradient(135deg, #FFD700, #FFA500);
            color: #000;
            font-size: 0.65rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 6px;
        }

        .qr-container {
            text-align: center;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.2rem;
            margin-bottom: 1.2rem;
        }

        .qr-box {
            background: #fff;
            padding: 10px;
            display: inline-block;
            border-radius: 12px;
            border: 3px solid var(--primary);
            margin: 8px 0;
        }

        .qr-box img {
            width: 160px;
            height: 160px;
            display: block;
        }

        .alert {
            padding: 10px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 1rem;
            display: none;
        }

        .alert-danger {
            background: rgba(239, 68, 68, 0.15);
            color: var(--danger);
            border: 1px solid var(--danger);
        }

        .alert-success {
            background: rgba(0, 210, 106, 0.15);
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        @media (max-width: 992px) {
            aside { display: none; }
            .main-wrapper { margin-left: 0; }
            .dashboard-body { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <!-- Sidebar Menu -->
    <aside>
        <!-- গোল লোগো যুক্ত করা হয়েছে -->
        <div class="brand-logo">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #00d26a, #2563eb); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(0, 210, 106, 0.4);">
                <i class="fa-solid fa-sim-card" style="color: #000; font-size: 1.1rem;"></i>
            </div>
            <div>
                <span style="font-size: 1.15rem; font-weight: 800; color: #fff;">Premium<span style="color: #00d26a;">OTP</span></span>
                <br>
                <span class="brand-badge">PRO</span>
            </div>
        </div>
        <ul class="nav-menu">
            <li class="nav-item active"><a href="#"><i class="fa-solid fa-gauge-high"></i> Dashboard</a></li>
            <li class="nav-item"><a href="#"><i class="fa-solid fa-mobile-screen"></i> Get Number</a></li>
            <li class="nav-item"><a onclick="openPaymentModal()"><i class="fa-solid fa-wallet"></i> Recharge Balance</a></li>
            <li class="nav-item"><a href="#"><i class="fa-solid fa-clock-rotate-left"></i> History Log</a></li>
            <li class="nav-item"><a href="#"><i class="fa-solid fa-headset"></i> Support Ticket</a></li>
        </ul>
    </aside>

    <!-- Main Workspace -->
    <div class="main-wrapper">
        <header>
            <div class="header-title">Virtual SMS & UPI Gateway</div>
            <div class="user-widget">
                <div class="balance-chip">
                    <i class="fa-solid fa-wallet"></i> Balance: ₹<span id="balanceVal">0.00</span>
                </div>
                <button class="btn-deposit" onclick="openPaymentModal()"><i class="fa-solid fa-plus"></i> Add Funds</button>
            </div>
        </header>

        <div class="dashboard-body">
            
            <!-- Left Order Form -->
            <div class="card">
                <div class="card-header">
                    <span><i class="fa-solid fa-cart-flatbed" style="color: var(--primary);"></i> Order Virtual Number</span>
                </div>

                <label class="form-label">Select Service</label>
                <select class="form-control" id="serviceSel">
                    <option>WhatsApp Verification</option>
                    <option>Telegram Verification</option>
                    <option>Google / Gmail OTP</option>
                    <option>Facebook Activation</option>
                    <option>Instagram Verification</option>
                </select>

                <label class="form-label">Select Country (Code & Rate)</label>
                <select class="form-control" id="countrySel" onchange="updatePrice()">
                    <option value="35.00" data-code="+91">🇮🇳 India (+91) - ₹35.00</option>
                    <option value="12.00" data-code="+880">🇧🇩 Bangladesh (+880) - ₹12.00</option>
                    <option value="14.00" data-code="+92">🇵🇰 Pakistan (+92) - ₹14.00</option>
                    <option value="8.00" data-code="+62">🇮🇩 Indonesia (+62) - ₹8.00</option>
                    <option value="10.00" data-code="+1">🇺🇸 United States (+1) - ₹10.00</option>
                    <option value="15.00" data-code="+44">🇬🇧 United Kingdom (+44) - ₹15.00</option>
                    <option value="18.00" data-code="+971">🇦🇪 UAE (+971) - ₹18.00</option>
                    <option value="16.00" data-code="+966">🇸🇦 Saudi Arabia (+966) - ₹16.00</option>
                </select>

                <div style="background: var(--bg-input); padding: 12px; border-radius: 8px; margin-bottom: 1.2rem; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Price per SMS:</span>
                    <span style="color: var(--primary); font-weight: 800;" id="priceTag">₹35.00</span>
                </div>

                <button class="btn-order" id="orderBtn" onclick="buyVirtualNumber()">
                    <i class="fa-solid fa-bolt"></i> Order Number
                </button>
            </div>

            <!-- Right Terminal & Active Monitoring -->
            <div>
                <div class="card">
                    <div class="card-header">
                        <span><i class="fa-solid fa-terminal" style="color: var(--primary);"></i> Active Verification Line</span>
                        <span id="sessionStatus" style="font-size: 0.8rem; color: var(--text-muted);">Status: Idle</span>
                    </div>

                    <div class="terminal-box">
                        <span style="font-size: 0.85rem; color: var(--text-muted);">Assigned Virtual Phone Number</span>
                        <div class="phone-display">
                            <span id="assignedPhone">No Active Number</span>
                            <button class="btn-copy" onclick="copyPhone()"><i class="fa-regular fa-copy"></i></button>
                        </div>
                        <span style="font-size: 0.8rem; color: var(--text-muted);" id="statusText">Order a number to receive OTP.</span>
                    </div>

                    <div class="otp-display-terminal">
                        <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Received One-Time Password</span>
                        <div class="otp-code" id="otpBox">------</div>

                        <div class="timer-badge">
                            <i class="fa-regular fa-clock"></i> Expire In: <strong id="timerText">05:00</strong>
                        </div>
                        <br>
                        <button class="btn-cancel" id="cancelBtn" onclick="cancelOrder()" disabled>Cancel & Refund</button>
                    </div>
                </div>

                <!-- Recent Transactions History Table -->
                <div class="card" style="margin-top: 20px;">
                    <div class="card-header">
                        <span><i class="fa-solid fa-history"></i> Recent Transactions</span>
                    </div>
                    <div class="table-responsive">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>Number</th>
                                    <th>OTP</th>
                                    <th>Cost</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="historyBody">
                                <tr>
                                    <td colspan="5" style="text-align: center; color: var(--text-muted);">No orders yet.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Deposit History Table -->
                <div class="card" style="margin-top: 20px;">
                    <div class="card-header">
                        <span><i class="fa-solid fa-money-bill-transfer"></i> Deposit Requests & Status</span>
                    </div>
                    <div class="table-responsive">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>UTR No</th>
                                    <th>Amount</th>
                                    <th>Bonus</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="depositHistoryBody">
                                <tr id="emptyDepRow">
                                    <td colspan="4" style="text-align: center; color: var(--text-muted);">No deposits submitted.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- UPI Deposit Modal Window -->
    <div class="modal-overlay" id="paymentModal">
        <div class="payment-card">
            <div class="card-header">
                <h2><i class="fa-solid fa-qrcode" style="color: var(--primary);"></i> UPI Deposit</h2>
                <i class="fa-solid fa-xmark" style="position: absolute; right: 20px; top: 20px; cursor: pointer; font-size: 1.2rem;" onclick="closePaymentModal()"></i>
            </div>

            <div id="alertBox" class="alert"></div>

            <label class="form-label">Select Deposit Plan:</label>
            <div class="amount-options">
                <div class="amount-btn active" onclick="selectAmount(50, 0, this)">
                    ₹50
                </div>
                <div class="amount-btn" onclick="selectAmount(100, 50, this)">
                    ₹100
                    <span class="bonus-tag">+₹50 Extra</span>
                </div>
                <div class="amount-btn" onclick="selectAmount(500, 0, this)">
                    ₹500
                </div>
            </div>

            <div class="qr-container">
                <span style="font-size: 0.8rem; color: var(--text-muted);">Scan with PhonePe, GPay, Paytm, BHIM:</span>
                <div class="qr-box">
                    <img id="qrCodeImg" src="" alt="UPI QR Code">
                </div>
                <div style="font-size: 0.95rem; font-weight: 700; color: var(--primary);">Payable: ₹<span id="payableText">50</span></div>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">UPI ID: <b>imran9999@fam</b></div>
            </div>

            <label class="form-label">Enter 12-Digit UTR / Transaction No:</label>
            <input type="text" class="custom-input form-control" id="utrInput" placeholder="e.g. 329104820192" maxlength="12">

            <button class="btn-order" onclick="verifyAndSubmitPayment()">
                <i class="fa-solid fa-circle-check"></i> Submit Transaction
            </button>
        </div>
    </div>

    <!-- Script Logic with localStorage -->
    <script>
        const UPI_ID = "imran9999@fam";
        const PAYEE_NAME = "Imran HQ";

        let balance = parseFloat(localStorage.getItem('user_balance')) || 0.00;
        let currentPrice = 35.00;
        let countdown = null;
        let otpTimeout = null;
        let isOrderActive = false;

        let selectedDeposit = 50;
        let selectedBonus = 0;

        let usedUTRList = JSON.parse(localStorage.getItem('used_utr')) || ["123456789012", "000000000000", "111111111111"];
        let historyData = JSON.parse(localStorage.getItem('order_history')) || [];
        let depositData = JSON.parse(localStorage.getItem('deposit_history')) || [];

        // Load data on page load
        window.onload = function() {
            document.getElementById("balanceVal").innerText = balance.toFixed(2);
            renderHistory();
            renderDepositHistory();
            updatePrice();
        };

        function saveAppData() {
            localStorage.setItem('user_balance', balance);
            localStorage.setItem('used_utr', JSON.stringify([...usedUTRList]));
            localStorage.setItem('order_history', JSON.stringify(historyData));
            localStorage.setItem('deposit_history', JSON.stringify(depositData));
        }

        function updatePrice() {
            const sel = document.getElementById("countrySel");
            currentPrice = parseFloat(sel.value);
            document.getElementById("priceTag").innerText = "₹" + currentPrice.toFixed(2);
        }

        function openPaymentModal() {
            document.getElementById("paymentModal").style.display = "flex";
            generateQR();
        }

        function closePaymentModal() {
            document.getElementById("paymentModal").style.display = "none";
            hideAlert();
        }

        function generateQR() {
            document.getElementById("payableText").innerText = selectedDeposit;
            const upiUrl = `upi://pay?pa=${UPI_ID}&pn=${encodeURIComponent(PAYEE_NAME)}&am=${selectedDeposit}&cu=INR`;
            const qrApi = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(upiUrl)}`;
            document.getElementById("qrCodeImg").src = qrApi;
        }

        function selectAmount(amount, bonus, element) {
            selectedDeposit = amount;
            selectedBonus = bonus;

            const btns = document.querySelectorAll(".amount-btn");
            btns.forEach(btn => btn.classList.remove("active"));
            element.classList.add("active");

            generateQR();
            hideAlert();
        }

        function showAlert(msg, isSuccess) {
            const alertBox = document.getElementById("alertBox");
            alertBox.className = `alert ${isSuccess ? 'alert-success' : 'alert-danger'}`;
            alertBox.innerText = msg;
            alertBox.style.display = "block";
        }

        function hideAlert() {
            document.getElementById("alertBox").style.display = "none";
        }

        function verifyAndSubmitPayment() {
            const utr = document.getElementById("utrInput").value.trim();

            if (!/^\d{12}$/.test(utr)) {
                showAlert("Invalid UTR! Enter a valid 12-digit Transaction ID.", false);
                return;
            }

            if (/^(\d)\1{11}$/.test(utr) || utr === "123456789012" || utr === "987654321098") {
                showAlert("Fake Transaction ID Detected! Refused.", false);
                return;
            }

            if (usedUTRList.includes(utr)) {
                showAlert("This UTR has already been submitted!", false);
                return;
            }

            usedUTRList.push(utr);

            const newDeposit = {
                utr: utr,
                amount: selectedDeposit,
                bonus: selectedBonus,
                status: "Processing"
            };

            depositData.unshift(newDeposit);
            saveAppData();
            renderDepositHistory();

            showAlert("Transaction submitted successfully! Status is Processing.", true);
            document.getElementById("utrInput").value = "";
            setTimeout(() => {
                closePaymentModal();
            }, 1800);
        }

        function renderDepositHistory() {
            const depositBody = document.getElementById("depositHistoryBody");
            if (depositData.length === 0) {
                depositBody.innerHTML = `<tr id="emptyDepRow"><td colspan="4" style="text-align: center; color: var(--text-muted);">No deposits submitted.</td></tr>`;
                return;
            }

            depositBody.innerHTML = "";
            depositData.forEach(dep => {
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td>${dep.utr}</td>
                    <td>₹${dep.amount}</td>
                    <td>₹${dep.bonus}</td>
                    <td><span class="badge-processing">${dep.status}</span></td>
                `;
                depositBody.appendChild(tr);
            });
        }

        function buyVirtualNumber() {
            if(balance < currentPrice) {
                alert("Insufficient balance! Your current balance is ₹" + balance.toFixed(2) + ". Please add funds via UPI.");
                openPaymentModal();
                return;
            }

            balance -= currentPrice;
            document.getElementById("balanceVal").innerText = balance.toFixed(2);
            saveAppData();
            isOrderActive = true;

            document.getElementById("orderBtn").disabled = true;
            document.getElementById("cancelBtn").disabled = false;
            document.getElementById("otpBox").innerText = "------";
            document.getElementById("statusText").innerText = "Waiting for SMS code (Arriving in 10s)...";
            document.getElementById("sessionStatus").innerText = "Status: Active";
            document.getElementById("sessionStatus").style.color = "var(--primary)";

            const sel = document.getElementById("countrySel");
            const opt = sel.options[sel.selectedIndex];
            const countryCode = opt.getAttribute("data-code");

            const firstDigit = Math.floor(Math.random() * 3) + 7;
            const remaining9Digits = Math.floor(100000000 + Math.random() * 900000000);
            const tenDigitNumber = `${firstDigit}${remaining9Digits}`;

            const formattedTenDigit = tenDigitNumber.substring(0, 5) + " " + tenDigitNumber.substring(5);
            const fullNumberWithCode = `${countryCode} ${formattedTenDigit}`;

            document.getElementById("assignedPhone").innerText = fullNumberWithCode;

            startTimer(300);

            otpTimeout = setTimeout(() => {
                if (!isOrderActive) return;
                
                const generatedOTP = Math.floor(100000 + Math.random() * 900000);
                document.getElementById("otpBox").innerText = generatedOTP;
                document.getElementById("statusText").innerText = "OTP Received Successfully!";
                
                const serviceName = document.getElementById("serviceSel").value;

                const newOrder = {
                    service: serviceName,
                    number: fullNumberWithCode,
                    otp: generatedOTP,
                    cost: currentPrice.toFixed(2),
                    status: "Success"
                };

                historyData.unshift(newOrder);
                saveAppData();
                renderHistory();

                clearInterval(countdown);
                isOrderActive = false;
                document.getElementById("orderBtn").disabled = false;
                document.getElementById("cancelBtn").disabled = true;
            }, 10000);
        }

        function renderHistory() {
            const tbody = document.getElementById("historyBody");
            if (historyData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: var(--text-muted);">No orders yet.</td></tr>`;
                return;
            }

            tbody.innerHTML = "";
            historyData.forEach(item => {
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>${item.service}</td>
                    <td>${item.number}</td>
                    <td><b>${item.otp}</b></td>
                    <td>₹${item.cost}</td>
                    <td><span class="badge-success">${item.status}</span></td>
                `;
                tbody.appendChild(row);
            });
        }

        function startTimer(seconds) {
            clearInterval(countdown);
            let time = seconds;
            countdown = setInterval(() => {
                let m = Math.floor(time / 60);
                let s = time % 60;
                m = m < 10 ? "0" + m : m;
                s = s < 10 ? "0" + s : s;
                document.getElementById("timerText").innerText = m + ":" + s;

                if(--time < 0) {
                    clearInterval(countdown);
                    isOrderActive = false;
                    document.getElementById("timerText").innerText = "Expired";
                    document.getElementById("statusText").innerText = "Session expired without OTP.";
                    document.getElementById("orderBtn").disabled = false;
                    document.getElementById("cancelBtn").disabled = true;
                }
            }, 1000);
        }

        function cancelOrder() {
            if (!isOrderActive) return;

            balance += currentPrice;
            document.getElementById("balanceVal").innerText = balance.toFixed(2);
            saveAppData();

            clearInterval(countdown);
            clearTimeout(otpTimeout);
            isOrderActive = false;

            document.getElementById("assignedPhone").innerText = "No Active Number";
            document.getElementById("otpBox").innerText = "------";
            document.getElementById("timerText").innerText = "05:00";
            document.getElementById("statusText").innerText = "Order canceled. Amount refunded to wallet.";
            document.getElementById("sessionStatus").innerText = "Status: Idle";
            document.getElementById("sessionStatus").style.color = "var(--text-muted)";

            document.getElementById("orderBtn").disabled = false;
            document.getElementById("cancelBtn").disabled = true;

            alert("Order Canceled Successfully! ₹" + currentPrice.toFixed(2) + " has been refunded to your wallet.");
        }

        function copyPhone() {
            const p = document.getElementById("assignedPhone").innerText;
            if(p === "No Active Number") return;
            navigator.clipboard.writeText(p);
            alert("Copied: " + p);
        }
    </script>
</body>
</html>
